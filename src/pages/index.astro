---
import { Image, getImage } from "astro:assets";
import { ArrowRight } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import Testimonial from "../components/Testimonial.astro";
import CtaBand from "../components/CtaBand.astro";
import { photos } from "../data/photos";
import { site } from "../data/site";

const services = [
  {
    href: "/weddings",
    title: "Weddings",
    text: "Relaxed, natural coverage from the first look to the last dance.",
    photo: photos.wedWoods,
  },
  {
    href: "/portraits",
    title: "Portraits & Newborn",
    text: "Families, couples, bumps and brand-new arrivals, in the studio or outdoors.",
    photo: photos.newborn,
  },
  {
    href: "/sessions",
    title: "APY Sessions",
    text: "Limited one-off mini sessions at favourite local spots like Newmillerdam.",
    photo: photos.woodsAutumn,
  },
  {
    href: "/studio",
    title: "Studio services",
    text: "Passport photos, headshots, printing, framing and canvases on Station Road.",
    photo: photos.camerasVintage,
  },
];

// Art-directed hero: a centred 4:5 crop for portrait screens, the full landscape frame elsewhere.
const srcset = async (widths: number[], format: "avif" | "webp", ratio?: number) =>
  (
    await Promise.all(
      widths.map(async (width) => {
        const img = await getImage({
          src: photos.hero.src,
          width,
          ...(ratio && { height: Math.round(width * ratio), fit: "cover" as const, position: "center" }),
          format,
          quality: format === "avif" ? 45 : 65,
        });
        return `${img.src} ${width}w`;
      }),
    )
  ).join(", ");

const portraitWidths = [480, 640, 750, 960, 1200];
const landscapeWidths = [960, 1280, 1600, 1797];
const hero = {
  portraitAvif: await srcset(portraitWidths, "avif", 1.25),
  portraitWebp: await srcset(portraitWidths, "webp", 1.25),
  landscapeAvif: await srcset(landscapeWidths, "avif"),
  landscapeWebp: await srcset(landscapeWidths, "webp"),
  fallback: await getImage({ src: photos.hero.src, width: 1600, format: "jpg", quality: 75 }),
};
---

<Base>
  <section class="relative isolate -mt-18 flex min-h-[92svh] items-end overflow-hidden">
    <picture>
      <source media="(orientation: portrait)" type="image/avif" srcset={hero.portraitAvif} sizes="100vw" />
      <source media="(orientation: portrait)" type="image/webp" srcset={hero.portraitWebp} sizes="100vw" />
      <source type="image/avif" srcset={hero.landscapeAvif} sizes="100vw" />
      <source type="image/webp" srcset={hero.landscapeWebp} sizes="100vw" />
      <img
        src={hero.fallback.src}
        alt={photos.hero.alt}
        width={photos.hero.src.width}
        height={photos.hero.src.height}
        fetchpriority="high"
        decoding="async"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
    </picture>
    <div class="absolute inset-0 -z-10 bg-linear-to-t from-black/70 via-black/25 to-black/10" aria-hidden="true"></div>
    <div class="hero-copy mx-auto w-full max-w-7xl px-4 pt-40 pb-16 text-white sm:px-6 sm:pb-24 lg:px-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase opacity-90">Wedding &amp; portrait photographer · Ossett</p>
      <h1 class="mt-4 max-w-4xl text-display">
        A Picture of <em class="font-light">You</em>
      </h1>
      <p class="mt-5 max-w-xl text-lg opacity-90 sm:text-xl">{site.tagline}, from your wedding day to your newest arrival.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contact" class="rounded-full bg-white px-7 py-3.5 font-semibold text-plum-deep transition-colors hover:bg-ivory"
          >Check your date</a
        >
        <a
          href="/weddings"
          class="rounded-full border border-white/70 px-7 py-3.5 font-semibold text-white backdrop-blur-xs transition-colors hover:bg-white/15"
          >See the work</a
        >
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-7xl gap-10 px-4 py-24 sm:px-6 md:grid-cols-12 lg:px-8">
    <div class="md:col-span-5">
      <p class="eyebrow">Welcome</p>
      <h2 class="mt-4 text-4xl leading-tight sm:text-5xl">Preserving memories for the Ossett community</h2>
    </div>
    <div class="prose-apy text-lg text-muted md:col-span-6 md:col-start-7">
      <p>
        We're photographers based on Station Road in Ossett, West Yorkshire. Weddings and portraiture are at the heart of
        what we do, alongside a full studio offering: passports, headshots, second-chance school photos, photo gifts,
        wall art and instant printing.
      </p>
      <p>
        We also stock a range of frames and offer bespoke framing and canvases, made with our own wide-format printers. We
        love meeting people, so pop in or get in touch for a chat.
      </p>
    </div>
  </section>

  <section aria-labelledby="services-heading" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="services-heading" class="sr-only">What we do</h2>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        services.map(({ href, title, text, photo }) => (
          <li>
            <a href={href} class="group block">
              <div class="overflow-hidden rounded-sm bg-blush">
                <Image
                  src={photo.src}
                  alt=""
                  widths={[360, 540, 720]}
                  quality={60}
                  sizes="(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw"
                  class="aspect-4/5 w-full object-cover transition-transform duration-700 ease-(--ease-out-soft) group-hover:scale-103"
                />
              </div>
              <h3 class="mt-5 flex items-center gap-2 text-2xl group-hover:text-plum">
                {title}
                <ArrowRight size={18} class="transition-transform group-hover:translate-x-1" aria-hidden="true" />
              </h3>
              <p class="mt-2 text-muted">{text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto mt-24 grid max-w-7xl items-center gap-12 px-4 sm:px-6 md:grid-cols-2 lg:px-8">
    <div class="reveal grid grid-cols-2 gap-4">
      <Image src={photos.wedChic.src} alt={photos.wedChic.alt} widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" class="aspect-3/4 w-full rounded-sm object-cover" />
      <Image src={photos.babySleep.src} alt={photos.babySleep.alt} widths={[320, 480, 640]} sizes="(min-width: 768px) 25vw, 50vw" class="mt-12 aspect-3/4 w-full rounded-sm object-cover" />
    </div>
    <div>
      <p class="eyebrow">Meet Graham</p>
      <h2 class="mt-4 text-4xl leading-tight sm:text-5xl">Good photos start with feeling at ease</h2>
      <p class="mt-6 text-lg text-muted">
        Successful photography takes more than technical know-how. Graham builds trust quickly with every client, so you
        can relax and be yourself, and the pictures look like you.
      </p>
      <a href="/about" class="mt-8 inline-flex items-center gap-2 font-semibold text-plum hover:underline hover:underline-offset-4">
        More about Graham <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>

  <div class="mt-24">
    <Testimonial />
  </div>

  <CtaBand />
</Base>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-copy > * {
      animation: hero-rise 1s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero-copy > :nth-child(2) {
      animation-delay: 90ms;
    }
    .hero-copy > :nth-child(3) {
      animation-delay: 180ms;
    }
    .hero-copy > :nth-child(4) {
      animation-delay: 270ms;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0.001;
      translate: 0 1.25rem;
    }
  }
</style>
