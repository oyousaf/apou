---
import { actions, isInputError } from "astro:actions";
import { Phone, Mail, MapPin, CircleCheck } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import { enquiryTypes } from "../actions";
import { site } from "../data/site";

export const prerender = false;

const result = Astro.getActionResult(actions.contact);
const fieldErrors = isInputError(result?.error) ? result.error.fields : {};
const formError = result?.error && !isInputError(result.error) ? result.error.message : null;
const sent = result?.data?.ok === true;

const requested = Astro.url.searchParams.get("enquiry") ?? "";
const preselect =
  enquiryTypes.find((type) => requested.toLowerCase().includes(type.toLowerCase().split(" ")[0])) ??
  (/essentials|signature/i.test(requested) ? "Wedding" : /small|newmillerdam/i.test(requested) ? "APY Session" : "");

const field = "mt-2 block w-full rounded-sm border border-line bg-surface px-4 py-3 text-ink placeholder:text-muted/70 focus:border-plum focus:outline-hidden focus-visible:ring-3 focus-visible:ring-plum/30 aria-invalid:border-danger";
const label = "block text-sm font-semibold";
const err = (name: string) => (fieldErrors as Record<string, string[] | undefined>)[name]?.[0];
---

<Base title="Contact" description={`Get in touch with ${site.name} Photography in Ossett. Call ${site.phone}, email or send an enquiry online.`}>
  <section class="mx-auto grid max-w-7xl gap-16 px-4 pt-12 pb-8 sm:px-6 md:pt-20 lg:grid-cols-12 lg:px-8">
    <div class="lg:col-span-5">
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 text-5xl leading-[1.05] sm:text-6xl">Let's talk</h1>
      <p class="mt-6 text-lg text-muted">
        Interested in working together, got a question, or just want to say hi? Send a message and Graham will get back to
        you as soon as he can.
      </p>
      <address class="mt-10 space-y-4 not-italic">
        <a href={`tel:${site.phoneE164}`} class="flex items-center gap-4 text-lg hover:text-plum">
          <span class="inline-flex size-11 items-center justify-center rounded-full bg-blush text-plum"><Phone size={20} aria-hidden="true" /></span>
          {site.phone}
        </a>
        <a href={`mailto:${site.email}`} class="flex items-center gap-4 text-lg break-all hover:text-plum">
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-blush text-plum"><Mail size={20} aria-hidden="true" /></span>
          {site.email}
        </a>
        <a href={site.links.maps} rel="noopener" class="flex items-center gap-4 text-lg hover:text-plum">
          <span class="inline-flex size-11 items-center justify-center rounded-full bg-blush text-plum"><MapPin size={20} aria-hidden="true" /></span>
          {site.address.street}, {site.address.locality}
        </a>
      </address>
    </div>

    <div class="lg:col-span-7">
      {
        sent ? (
          <div role="status" class="rounded-sm border border-plum bg-surface p-10">
            <CircleCheck size={36} class="text-plum" aria-hidden="true" />
            <h2 class="mt-4 text-3xl">Thank you, your message is on its way</h2>
            <p class="mt-3 text-muted">Graham will reply as soon as he can, usually within a couple of days.</p>
          </div>
        ) : (
          <form method="POST" action={actions.contact} class="space-y-6 rounded-sm border border-line bg-surface/60 p-6 sm:p-10">
            <p class="text-sm text-muted">
              Fields marked <span aria-hidden="true">*</span>
              <span class="sr-only">with an asterisk</span> are required.
            </p>

            {formError && (
              <p role="alert" class="rounded-sm border border-danger/40 bg-blush px-4 py-3 text-danger">
                {formError}
              </p>
            )}

            <div class="grid gap-6 sm:grid-cols-2">
              <div>
                <label for="name" class={label}>Name <span aria-hidden="true">*</span></label>
                <input id="name" name="name" type="text" autocomplete="name" required maxlength="80" class={field}
                  aria-invalid={err("name") ? "true" : undefined} aria-describedby={err("name") ? "name-error" : undefined} />
                {err("name") && <p id="name-error" class="mt-2 text-sm text-danger">{err("name")}</p>}
              </div>
              <div>
                <label for="email" class={label}>Email <span aria-hidden="true">*</span></label>
                <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="320" class={field}
                  aria-invalid={err("email") ? "true" : undefined} aria-describedby={err("email") ? "email-error" : undefined} />
                {err("email") && <p id="email-error" class="mt-2 text-sm text-danger">{err("email")}</p>}
              </div>
              <div>
                <label for="phone" class={label}>Phone <span class="font-normal text-muted">(optional)</span></label>
                <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" class={field} />
              </div>
              <div>
                <label for="date" class={label}>Date, if you have one <span class="font-normal text-muted">(optional)</span></label>
                <input id="date" name="date" type="text" maxlength="40" placeholder="e.g. June 2027" class={field} />
              </div>
            </div>

            <div>
              <label for="enquiry" class={label}>What are you enquiring about? <span aria-hidden="true">*</span></label>
              <select id="enquiry" name="enquiry" required class={field}
                aria-invalid={err("enquiry") ? "true" : undefined} aria-describedby={err("enquiry") ? "enquiry-error" : undefined}>
                <option value="" selected={!preselect}>Choose one</option>
                {enquiryTypes.map((type) => <option selected={type === preselect}>{type}</option>)}
              </select>
              {err("enquiry") && <p id="enquiry-error" class="mt-2 text-sm text-danger">{err("enquiry")}</p>}
            </div>

            <div>
              <label for="message" class={label}>Message <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="6" required maxlength="3000" class={field}
                aria-invalid={err("message") ? "true" : undefined} aria-describedby={err("message") ? "message-error" : undefined}
                set:text={requested ? `I'm interested in: ${requested}\n\n` : ""} />
              {err("message") && <p id="message-error" class="mt-2 text-sm text-danger">{err("message")}</p>}
            </div>

            <div class="hidden" aria-hidden="true">
              <label for="company">Leave this empty</label>
              <input id="company" name="company" type="text" tabindex="-1" autocomplete="off" />
            </div>
            <input type="hidden" name="ts" value={Date.now()} />

            <button type="submit" class="inline-flex rounded-full bg-plum px-8 py-3.5 font-semibold text-on-plum transition-colors hover:bg-plum-strong">
              Send message
            </button>
            <p class="text-sm text-muted">We only use your details to reply to your enquiry.</p>
          </form>
        )
      }
    </div>
  </section>
</Base>
