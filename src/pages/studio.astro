---
import { IdCard, UserRound, Printer, Frame, Gift, School } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import CtaBand from "../components/CtaBand.astro";
import { photos } from "../data/photos";
import { site } from "../data/site";

const services = [
  { icon: IdCard, title: "Passport & ID photos", text: "Compliant passport, visa and ID photos taken and printed while you wait." },
  { icon: UserRound, title: "Headshots", text: "Professional headshots for LinkedIn, websites and team pages." },
  { icon: School, title: "School photo second chances", text: "Missed school picture day or not happy with the result? Come and see us." },
  { icon: Printer, title: "Printing", text: "Instant prints plus wide-format printing for posters and wall art." },
  { icon: Frame, title: "Framing & canvases", text: "Ready-made frames in stock, bespoke framing and canvases made to order." },
  { icon: Gift, title: "Photo gifts", text: "Turn your favourite pictures into gifts for birthdays, Christmas and keepsakes." },
];
---

<Base
  title="Studio: Passport Photos, Printing & Framing"
  description="Passport and ID photos, headshots, instant and wide-format printing, bespoke framing, canvases and photo gifts on Station Road, Ossett."
  image={photos.camerasVintage.src}
>
  <PageIntro eyebrow="The studio" title="Pop in on Station Road" photo={photos.headshotMan}>
    <p>
      Beyond weddings and portraits, the studio covers all the everyday photography you need, from a quick passport photo
      to framing a family heirloom.
    </p>
  </PageIntro>

  <section aria-labelledby="studio-heading" class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <h2 id="studio-heading" class="sr-only">Studio services</h2>
    <ul class="grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
      {
        services.map(({ icon: Icon, title, text }) => (
          <li>
            <span class="inline-flex size-12 items-center justify-center rounded-full bg-blush text-plum">
              <Icon size={22} aria-hidden="true" />
            </span>
            <h3 class="mt-5 text-2xl">{title}</h3>
            <p class="mt-2 text-muted">{text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section aria-labelledby="visit-heading" class="mx-auto mt-16 max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-8 rounded-sm border border-line bg-surface p-8 md:grid-cols-2">
      <div>
        <h2 id="visit-heading" class="text-3xl">Visit the studio</h2>
        <p class="mt-3 text-muted">{site.address.street}, {site.address.locality}, {site.address.region}</p>
        <a href={site.links.maps} rel="noopener" class="mt-6 inline-flex rounded-full border border-plum px-5 py-2.5 text-sm font-semibold text-plum hover:bg-plum hover:text-on-plum"
          >Get directions</a
        >
      </div>
      <div>
        <h3 class="text-xl">Opening hours</h3>
        <!-- TODO(graham): confirm opening hours -->
        <p class="mt-3 text-muted">Please call <a class="text-plum underline underline-offset-4" href={`tel:${site.phoneE164}`}>{site.phone}</a> before visiting.</p>
      </div>
    </div>
  </section>

  <CtaBand title="Need something printed or framed?" />
</Base>
