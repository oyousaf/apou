---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";
import Gallery from "../components/Gallery.astro";
import Packages from "../components/Packages.astro";
import Testimonial from "../components/Testimonial.astro";
import CtaBand from "../components/CtaBand.astro";
import { photos, weddingGallery } from "../data/photos";

const steps = [
  { title: "Say hello", text: "Tell us your date and venue. We'll check availability and arrange a chat, in the studio or by phone." },
  { title: "Plan together", text: "We talk through the day, the people who matter and the shots you'd love, so nothing is missed." },
  { title: "Enjoy your day", text: "Graham works quietly in the background, stepping in to guide groups and portraits when needed." },
  { title: "Relive it", text: "Your edited images arrive by USB or download, with an album on the Signature collection." },
];
---

<Base
  title="Wedding Photography"
  description="Natural, relaxed wedding photography in Ossett, Wakefield and across West Yorkshire. Collections from £650, with bespoke albums available."
  image={photos.hero.src}
>
  <PageIntro eyebrow="Weddings" title="Your day, exactly as it felt" photo={photos.wedWoods}>
    <p>
      Natural, unhurried wedding photography across West Yorkshire and beyond. Every picture is always of you: the
      laughter, the nerves, the quiet moments in between.
    </p>
    <a slot="actions" href="/contact?enquiry=Wedding" class="mt-8 inline-flex rounded-full bg-plum px-7 py-3.5 font-semibold text-on-plum hover:bg-plum-strong"
      >Check your date</a
    >
  </PageIntro>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <Gallery photos={weddingGallery} label="Wedding gallery" />
  </div>

  <Packages service="weddings" />

  <section aria-labelledby="how-heading" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 id="how-heading" class="text-4xl sm:text-5xl">How it works</h2>
    <ol class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
      {
        steps.map(({ title, text }, i) => (
          <li class="border-t border-line pt-6">
            <span class="font-display text-3xl text-plum" aria-hidden="true">0{i + 1}</span>
            <h3 class="mt-3 text-xl">{title}</h3>
            <p class="mt-2 text-muted">{text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <Testimonial />
  <CtaBand title="Is your date still free?" />
</Base>
