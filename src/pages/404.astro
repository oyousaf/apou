---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="mx-auto max-w-3xl px-4 py-32 text-center sm:px-6">
    <p class="eyebrow">404</p>
    <h1 class="mt-4 text-5xl sm:text-6xl">This picture's gone missing</h1>
    <p class="mt-6 text-lg text-muted">The page you're after may have moved. Try one of these instead.</p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-full bg-plum px-6 py-3 font-semibold text-on-plum hover:bg-plum-strong">Home</a>
      <a href="/weddings" class="rounded-full border border-plum px-6 py-3 font-semibold text-plum hover:bg-blush">Weddings</a>
      <a href="/contact" class="rounded-full border border-plum px-6 py-3 font-semibold text-plum hover:bg-blush">Contact</a>
    </div>
  </section>
</Base>
