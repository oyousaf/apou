---
import { Menu, X, ArrowUpRight } from "@lucide/astro";
import { nav, externalNav } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a href="/" class="text-ink transition-colors hover:text-plum" aria-label="A Picture of You, home">
      <span class="logo-mark w-36 sm:w-40" aria-hidden="true"></span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          nav.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isCurrent(href) ? "page" : undefined}
                class="rounded-full px-3 py-2 text-ink/80 transition-colors hover:text-plum aria-[current=page]:text-plum aria-[current=page]:underline aria-[current=page]:decoration-1 aria-[current=page]:underline-offset-8"
              >
                {label}
              </a>
            </li>
          ))
        }
        {
          externalNav.map(({ href, label }) => (
            <li>
              <a href={href} class="inline-flex items-center gap-1 rounded-full px-3 py-2 text-muted transition-colors hover:text-plum" rel="noopener">
                {label}
                <ArrowUpRight size={14} aria-hidden="true" />
                <span class="sr-only">(opens external site)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/contact"
        class="hidden rounded-full bg-plum px-5 py-2.5 text-sm font-semibold text-on-plum transition-colors hover:bg-plum-strong sm:inline-flex"
        >Enquire</a
      >
      <button
        type="button"
        popovertarget="mobile-menu"
        class="inline-flex size-11 items-center justify-center rounded-full text-ink hover:bg-blush lg:hidden"
        aria-label="Open menu"
      >
        <Menu size={22} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    popover
    class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-paper p-0 text-ink lg:hidden"
    aria-label="Menu"
  >
    <div class="flex h-18 items-center justify-between border-b border-line px-4 sm:px-6">
      <span class="logo-mark w-36" aria-hidden="true"></span>
      <button
        type="button"
        popovertarget="mobile-menu"
        popovertargetaction="hide"
        class="inline-flex size-11 items-center justify-center rounded-full hover:bg-blush"
        aria-label="Close menu"
      >
        <X size={22} aria-hidden="true" />
      </button>
    </div>
    <nav aria-label="Mobile" class="px-4 py-8 sm:px-6">
      <ul class="space-y-1">
        <li><a href="/" class="block py-2 font-display text-3xl" aria-current={path === "/" ? "page" : undefined}>Home</a></li>
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} class="block py-2 font-display text-3xl aria-[current=page]:text-plum" aria-current={isCurrent(href) ? "page" : undefined}>
                {label}
              </a>
            </li>
          ))
        }
        <li><a href="/contact" class="block py-2 font-display text-3xl aria-[current=page]:text-plum" aria-current={isCurrent("/contact") ? "page" : undefined}>Contact</a></li>
      </ul>
      <ul class="mt-8 flex flex-wrap gap-3 border-t border-line pt-8">
        {
          externalNav.map(({ href, label }) => (
            <li>
              <a href={href} rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-line px-4 py-2.5 text-sm hover:border-plum hover:text-plum">
                {label}
                <ArrowUpRight size={14} aria-hidden="true" />
                <span class="sr-only">(opens external site)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .mobile-menu {
    inset: 0;
    opacity: 0;
    translate: 0 -0.75rem;
    transition:
      opacity 200ms var(--ease-out-soft),
      translate 200ms var(--ease-out-soft),
      display 200ms allow-discrete,
      overlay 200ms allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
    translate: 0 0;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
      translate: 0 -0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>
