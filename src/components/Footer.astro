---
import { Phone, Mail, MapPin, ArrowUpRight } from "@lucide/astro";
import { site, nav, externalNav } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 md:grid-cols-12 lg:px-8">
    <div class="md:col-span-5">
      <a href="/" class="inline-block text-ink hover:text-plum" aria-label="A Picture of You, home">
        <span class="logo-mark w-48" aria-hidden="true"></span>
      </a>
      <p class="mt-6 max-w-sm text-muted">
        Wedding, portrait and newborn photography from our studio on Station Road, Ossett, plus printing, framing and
        passport photos while you wait.
      </p>
    </div>

    <nav aria-label="Footer" class="md:col-span-3">
      <h2 class="eyebrow font-sans">Explore</h2>
      <ul class="mt-4 space-y-1">
        {
          nav.map(({ href, label }) => (
            <li>
              <a href={href} class="inline-block py-1.5 hover:text-plum">
                {label}
              </a>
            </li>
          ))
        }
        <li><a href="/contact" class="inline-block py-1.5 hover:text-plum">Contact</a></li>
        {
          externalNav.map(({ href, label }) => (
            <li>
              <a href={href} rel="noopener" class="inline-flex items-center gap-1 py-1.5 hover:text-plum">
                {label}
                <ArrowUpRight size={14} aria-hidden="true" />
                <span class="sr-only">(opens external site)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-4">
      <h2 class="eyebrow font-sans">Visit or get in touch</h2>
      <address class="mt-4 space-y-3 not-italic">
        <a href={site.links.maps} rel="noopener" class="flex gap-3 py-1 hover:text-plum">
          <MapPin size={18} class="mt-0.5 shrink-0 text-plum" aria-hidden="true" />
          <span>{site.address.street}, {site.address.locality}<br />{site.address.region}</span>
        </a>
        <a href={`tel:${site.phoneE164}`} class="flex gap-3 py-1 hover:text-plum">
          <Phone size={18} class="mt-0.5 shrink-0 text-plum" aria-hidden="true" />
          <span>{site.phone}</span>
        </a>
        <a href={`mailto:${site.email}`} class="flex gap-3 py-1 break-all hover:text-plum">
          <Mail size={18} class="mt-0.5 shrink-0 text-plum" aria-hidden="true" />
          <span>{site.email}</span>
        </a>
      </address>
    </div>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-6 text-sm text-muted sm:flex-row sm:justify-between sm:px-6 lg:px-8">
      <p>© {year} {site.legalName}. Photography by {site.photographer}.</p>
      <p>Ossett, West Yorkshire</p>
    </div>
  </div>
</footer>
