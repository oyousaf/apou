---
import { Picture } from "astro:assets";
import type { Photo } from "../data/photos";

interface Props {
  eyebrow: string;
  title: string;
  photo?: Photo;
}

const { eyebrow, title, photo } = Astro.props;
---

<section class="mx-auto grid max-w-7xl items-end gap-10 px-4 pt-12 pb-16 sm:px-6 md:pt-20 lg:grid-cols-12 lg:px-8">
  <div class="hero-in lg:col-span-6">
    <p class="eyebrow">{eyebrow}</p>
    <h1 class="mt-4 text-5xl leading-[1.05] tracking-tight sm:text-6xl">{title}</h1>
    <div class="mt-6 max-w-xl text-lg text-muted">
      <slot />
    </div>
    <slot name="actions" />
  </div>
  {
    photo && (
      <div class="lg:col-span-6">
        <Picture
          src={photo.src}
          alt={photo.alt}
          formats={["avif", "webp"]}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          priority
          class="aspect-4/3 w-full rounded-sm object-cover"
        />
      </div>
    )
  }
</section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > :global(*) {
      animation: hero-rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .hero-in > :global(:nth-child(2)) {
      animation-delay: 80ms;
    }
    .hero-in > :global(:nth-child(3)) {
      animation-delay: 160ms;
    }
    .hero-in > :global(:nth-child(n + 4)) {
      animation-delay: 240ms;
    }
  }
  @keyframes hero-rise {
    from {
      opacity: 0.001;
      translate: 0 1rem;
    }
  }
</style>
