---
import { site } from "../data/site";

interface Props {
  title?: string;
}

const { title = "Let's create something you'll treasure" } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pt-24 sm:px-6 lg:px-8">
  <div class="reveal flex flex-col items-start gap-8 rounded-sm bg-plum px-8 py-14 text-on-plum sm:px-14 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 class="text-4xl sm:text-5xl">{title}</h2>
      <p class="mt-4 max-w-xl opacity-90">
        Tell Graham a little about what you have in mind. Or call
        <a href={`tel:${site.phoneE164}`} class="font-semibold underline underline-offset-4">{site.phone}</a>.
      </p>
    </div>
    <a
      href="/contact"
      class="shrink-0 rounded-full bg-on-plum px-7 py-3.5 font-semibold text-plum transition-opacity hover:opacity-90"
      >Start an enquiry</a
    >
  </div>
</section>
